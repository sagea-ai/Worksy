generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  clerkId             String           @unique
  email               String           @unique
  firstName           String?
  lastName            String?
  imageUrl            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  onboardingCompleted Boolean          @default(false)
  userType            UserType?
  jobPostings         JobPosting[]
  jobs                Job[]
  teamActivities      TeamActivity[]   @relation("TeamActivities")
  sentInvitations     TeamInvitation[] @relation("InvitationSender")
  receivedInvitations TeamInvitation[] @relation("InvitationReceiver")
  teamMemberships     TeamMember[]     @relation("TeamMemberships")
  createdTeams        Team[]           @relation("TeamCreator")
  profile             UserProfile?

  @@map("users")
}

model UserProfile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  selectedSkills         String[]
  experienceLevel        ExperienceLevel?
  preferredPlatforms     String[]
  hourlyRateMin          Float?
  hourlyRateMax          Float?
  availability           String?
  bio                    String?
  location               String?
  website                String?
  linkedIn               String?
  github                 String?
  timezone               String?
  workDescription        String?
  languages              String[]
  projectTypes           String[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  companyDescription     String?
  companyName            String?
  companySize            String?
  hiringNeeds            String[]
  industry               String?
  preferredRemote        Boolean?
  typicalBudgetMax       Float?
  typicalBudgetMin       Float?
  typicalProjectDuration String?
  positionTypes          String[]
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Job {
  id                String            @id @default(cuid())
  externalId        String
  platform          JobPlatform
  title             String
  description       String
  budget            Float?
  currency          String            @default("USD")
  skills            String[]
  location          String?
  isRemote          Boolean           @default(true)
  isUrgent          Boolean           @default(false)
  verified          Boolean           @default(false)
  clientRating      Float?
  state             JobState          @default(NEW)
  userId            String
  proposalSubmitted Boolean           @default(false)
  proposalText      String?
  proposedBudget    Float?
  proposedDeadline  DateTime?
  teamSummoned      Boolean           @default(false)
  teamSummonedAt    DateTime?
  assignedTeamId    String?
  startDate         DateTime?
  endDate           DateTime?
  actualBudget      Float?
  clientFeedback    String?
  rating            Float?
  aiAnalysis        Json?
  buildingPlan      Json?
  chatHistory       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  stateHistory      JobStateHistory[]
  teamAssignments   JobTeam[]
  assignedTeam      Team?             @relation("TeamAssignedJobs", fields: [assignedTeamId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId, userId])
  @@map("jobs")
}

model JobStateHistory {
  id        String    @id @default(cuid())
  jobId     String
  fromState JobState?
  toState   JobState
  reason    String?
  notes     String?
  changedBy String?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_state_history")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model Team {
  id             String           @id @default(cuid())
  name           String
  description    String?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  jobAssignments JobTeam[]
  assignedJobs   Job[]            @relation("TeamAssignedJobs")
  activities     TeamActivity[]
  invitations    TeamInvitation[]
  members        TeamMember[]
  creator        User             @relation("TeamCreator", fields: [createdBy], references: [id])

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation("TeamMemberships", fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id               String           @id @default(cuid())
  teamId           String
  invitedBy        String
  invitedUserEmail String
  invitedUserId    String?
  status           InvitationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  respondedAt      DateTime?
  inviter          User             @relation("InvitationSender", fields: [invitedBy], references: [id])
  invitedUser      User?            @relation("InvitationReceiver", fields: [invitedUserId], references: [id])
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, invitedUserEmail])
  @@map("team_invitations")
}

model TeamActivity {
  id           String       @id @default(cuid())
  teamId       String
  userId       String?
  activityType ActivityType
  description  String
  metadata     Json?
  createdAt    DateTime     @default(now())
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?        @relation("TeamActivities", fields: [userId], references: [id])

  @@map("team_activities")
}

model JobTeam {
  id         String   @id @default(cuid())
  jobId      String
  teamId     String
  assignedAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([jobId, teamId])
  @@map("job_teams")
}

model JobPosting {
  id                  String           @id @default(cuid())
  title               String
  description         String
  positionType        PositionType
  requiredSkills      String[]
  preferredExperience ExperienceLevel?
  budgetMin           Float?
  budgetMax           Float?
  currency            String           @default("USD")
  isNegotiable        Boolean          @default(true)
  location            String?
  isRemote            Boolean          @default(true)
  duration            String?
  status              JobPostingStatus @default(DRAFT)
  isPublic            Boolean          @default(true)
  postedBy            String
  viewCount           Int              @default(0)
  applicationCount    Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  publishedAt         DateTime?
  expiresAt           DateTime?
  poster              User             @relation(fields: [postedBy], references: [id], onDelete: Cascade)

  @@map("job_postings")
}

enum UserType {
  STUDENT
  HIRER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum JobState {
  NEW
  ANALYZING
  DECLINED
  PROPOSING
  PROPOSED
  NEGOTIATING
  TEAM_SUMMONED
  ORDER_CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ERROR
}

enum JobPlatform {
  FREELANCER
  UPWORK
  FIVERR
  TOPTAL
  GURU
  PEOPLEPERHOUR
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_INVITED
  TEAM_SUMMONED
  JOB_ASSIGNED
  PROJECT_STARTED
  PROJECT_COMPLETED
  TEAM_CREATED
}

enum PositionType {
  FREELANCER
  INTERNSHIP
  JOB
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}
